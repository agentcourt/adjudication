{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "adjudication-evals run result",
  "type": "object",
  "required": ["run_id", "created_at", "models", "items", "results"],
  "properties": {
    "run_id": {"type": "string"},
    "created_at": {"type": "string"},
    "questions": {"type": "string"},
    "models": {"type": "array", "items": {"type": "string"}},
    "trials": {"type": "integer", "minimum": 1},
    "items": {"type": "array", "items": {"type": "string"}},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "model", "raw_response", "metadata"],
        "properties": {
          "item_id": {"type": "string"},
          "model": {"type": "string"},
          "trial_index": {"type": "integer", "minimum": 1},
          "raw_response": {"type": "string"},
          "parsed_response": {"type": ["object", "null"]},
          "tool_trace": {"type": "array"},
          "metadata": {
            "type": "object",
            "required": ["error", "error_type"],
            "properties": {
              "trial_index": {"type": "integer", "minimum": 1},
              "elapsed_ms": {"type": ["number", "integer", "null"]},
              "error": {"type": "string"},
              "error_type": {"type": "string"},
              "cost": {"type": ["number", "string", "null"]}
            }
          }
        }
      }
    }
  }
}
